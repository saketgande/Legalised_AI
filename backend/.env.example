# Copy to .env for local dev. docker-compose brings up Postgres with these creds.
DATABASE_URL=postgresql+psycopg2://frontdoor:frontdoor@127.0.0.1:5432/frontdoor

# Auth. Set a strong random AUTH_SECRET in production.
AUTH_SECRET=dev-insecure-change-me
AUTH_DEMO_PASSWORD=demo1234

# Optional. When set, generation may ask Claude to polish recitals only.
# Absent -> deterministic playbook assembly (demo runs with no key).
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Polled email intake. The background loop drains every active mailbox on this
# cadence. On Render free tier (idle web services sleep) set EMAIL_POLLING_ENABLED=false
# and hit POST /api/intake/email/poll-cron from an external cron (X-Intake-Secret).
# EMAIL_POLLING_ENABLED=true
# EMAIL_POLL_INTERVAL_SECONDS=120

# E-signature (DocuSign). Set all three to use DocuSign; else the stub signs.
# DOCUSIGN_BASE_URI=https://demo.docusign.net/restapi
# DOCUSIGN_ACCOUNT_ID=
# DOCUSIGN_ACCESS_TOKEN=
# DOCUSIGN_CONNECT_HMAC=          # secures POST /api/esign/webhook
# ESIGN_SIGNER_EMAIL=            # demo override; defaults to the requester's email
